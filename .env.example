# Основной и единственный LLM: OpenAI-совместимый API хакатона.
# Скопируйте файл в .env и вставьте ключ. .env уже в .gitignore.
# Используются только модели из разрешённого списка:
# google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash,
# qwen/qwen3.6-35b-a3b, deepseek/deepseek-v4.1-flash,
# qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
# Если организаторы выдали другой адрес — замените значение.
LLM_BASE_URL=https://challenge.up.railway.app/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_API_KEY=sk-...

# Сервер
HOST=0.0.0.0
PORT=8000

# Пути к данным
# Для воспроизводимого демо на синтетической базе:
# CLIENT_DATA_CSV=./data/client_profiles/clients.csv
DATA_DIR=./data
CLIENT_PROFILES_DIR=./data/client_profiles
NEWS_DIR=./data/news
ALFA_ANALYTICS_DIR=./data/alfa_analytics

# Логи
LOG_LEVEL=INFO
