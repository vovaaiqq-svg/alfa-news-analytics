# Основной LLM: OpenAI-совместимый API хакатона.
# Скопируйте файл в .env и вставьте ключ. .env уже в .gitignore.
LLM_BASE_URL=https://challenge.up.railway.app/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_API_KEY=sk-...

# Локальный fallback (OpenCode) — используется, если LLM_API_KEY не задан.
# OPENCODE_URL=http://127.0.0.1:49374
# OPENCODE_MODEL=deepseek-v4.1-flash-free

# Сервер
HOST=0.0.0.0
PORT=8000

# Пути к данным
DATA_DIR=./data
CLIENT_PROFILES_DIR=./data/client_profiles
NEWS_DIR=./data/news
ALFA_ANALYTICS_DIR=./data/alfa_analytics

# Логи
LOG_LEVEL=INFO
